# Everything here is regenerated by build_usage.py from ~/.claude/projects, so it is output,
# not source. Committing it would put a diff on every run and store machine-local absolute
# paths in git — while the three source files (build_usage.py, prices.json, template.html)
# fully reproduce it on any machine.
data/
index.html

# Your own invoices. The dashboard keeps them in the browser; this file is only the durable
# copy for a fresh browser or a new machine, and it is nobody else's business.
billing_cycles.json

__pycache__/
.DS_Store

# Launch notes are working material for the author, not part of what people install.
LAUNCH.md
OUTREACH.md
